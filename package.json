{
  "name": "shelbyflix",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "A decentralized video sharing platform powered by Shelby Storage Network and Aptos blockchain",
  "repository": {
    "type": "git",
    "url": "https://github.com/Legendarytunzeverywhere/shelbyflix.git"
  },
  "keywords": [
    "web3",
    "blockchain",
    "aptos",
    "video-sharing",
    "decentralized",
    "shelby-storage",
    "nextjs",
    "react"
  ],
  "author": "ShelbyFlix Contributors",
  "bugs": {
    "url": "https://github.com/Legendarytunzeverywhere/shelbyflix/issues"
  },
  "homepage": "https://github.com/Legendarytunzeverywhere/shelbyflix#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "backfill": "tsx scripts/backfill-move-policies.ts",
    "rotate-video-keys": "tsx scripts/rotate-video-keys.ts --dry-run",
    "rotate-video-keys:plan": "tsx scripts/rotate-video-keys.ts --dry-run > scripts/rotate-video-keys.plan.json",
    "rotate-video-keys:admin": "node scripts/rotate-video-keys-admin-server.mjs"
  },
  "dependencies": {
    "@aptos-labs/ace-sdk": "0.1.1",
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@aptos-labs/wallet-adapter-core": "7.8.0",
    "@aptos-labs/wallet-adapter-react": "7.2.8",
    "@aptos-labs/wallet-standard": "0.5.2",
    "@headlessui/react": "2.2.9",
    "@heroicons/react": "2.2.0",
    "@supabase/supabase-js": "2.99.2",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.2.1",
    "@vercel/analytics": "^2.0.1",
    "@wallet-standard/core": "^1.1.1",
    "date-fns": "4.1.0",
    "dotenv": "16.4.7",
    "lucide-react": "0.577.0",
    "next": "15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hot-toast": "2.4.1",
    "react-player": "3.4.0",
    "react-select": "5.10.2",
    "styled-jsx": "5.1.7"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.4.1",
    "@shelby-protocol/sdk": "^0.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "10.4.0",
    "eslint": "9.0.0",
    "eslint-config-next": "15.5.18",
    "fast-check": "^4.7.0",
    "got": "11.8.6",
    "jsdom": "^29.1.1",
    "postcss": "8.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.19.4",
    "typescript": "5.3.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "valibot": ">=1.2.0"
  }
}
