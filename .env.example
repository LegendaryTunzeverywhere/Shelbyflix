# ============================================================================
# SHELBYNET CONFIGURATION
# ============================================================================
# This application runs on Shelbynet (Aptos-based network for Shelby Protocol)
# Official Documentation: https://docs.shelby.xyz

# Network Configuration
# Network name for wallet configuration
NEXT_PUBLIC_NETWORK_NAME=shelbynet

# Shelbynet RPC Endpoints
NEXT_PUBLIC_SHELBYNET_NODE_URL=https://api.shelbynet.shelby.xyz/v1
NEXT_PUBLIC_SHELBYNET_INDEXER_URL=https://api.shelbynet.shelby.xyz/v1/graphql
NEXT_PUBLIC_SHELBYNET_FAUCET_URL=https://faucet.shelbynet.shelby.xyz

# ============================================================================
# SHELBYUSD TOKEN CONFIGURATION
# ============================================================================
# ShelbyUSD is the native token used for:
# 1. Paying upload fees when storing blobs on Shelby network
# 2. Token-gating access to videos
# 
# Token Details:
# - Name: ShelbyUSD
# - Symbol: USD
# - Decimals: 8
# - Type: 0x1b18363a9f1fe5e6ebf247daba5cc1c18052bb232efdc4c50f556053922d98e1
#
# Get test tokens from faucet:
# https://faucet.shelbynet.shelby.xyz
# 
NEXT_PUBLIC_SHELBYUSD_TOKEN_ADDRESS=0x1b18363a9f1fe5e6ebf247daba5cc1c18052bb232efdc4c50f556053922d98e1

# Module address where your smart contract is deployed (optional - for on-chain metadata)
NEXT_PUBLIC_MODULE_ADDRESS=0xYOUR_MODULE_ADDRESS_HERE

# ============================================================================
# SHELBY STORAGE API
# ============================================================================
# Shelby decentralized storage configuration
NEXT_PUBLIC_SHELBY_API_URL=https://api.shelbynet.shelby.xyz/v1

# Shelby API Key (obtain from Shelby dashboard)
# For development: AG-8HZAYGCS7BWJBCMAB6P9SGH6AHUWDVOOF
# For production: Get your own key from https://docs.shelby.xyz
SHELBY_API_KEY=apai here
NEXT_PUBLIC_SHELBY_API_KEY=api here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Minimum ShelbyUSD balance required to upload and access videos
# Default: 0.1 ShelbyUSD (10,000,000 in smallest unit with 8 decimals)
NEXT_PUBLIC_MIN_TOKEN_BALANCE=0.1

# Maximum video file size (in bytes) - Shelby supports up to 500MB
# Default: 100MB for faster uploads during testing
NEXT_PUBLIC_MAX_VIDEO_SIZE=104857600

# Development Mode (set to 'true' to bypass token checks for testing UI)
# WARNING: Set to 'false' in production!
NEXT_PUBLIC_DEV_MODE=false

# ============================================================================
# WALLET CONFIGURATION
# ============================================================================
# Add Shelbynet to your Aptos wallet:
#
# Network Name: shelbynet
# Node URL: https://api.shelbynet.shelby.xyz/v1
# Faucet URL: https://faucet.shelbynet.shelby.xyz  
# Indexer URL: https://api.shelbynet.shelby.xyz/v1/graphql
#
# After adding the network, request test ShelbyUSD tokens from:
# https://faucet.shelbynet.shelby.xyz
# ============================================================================

