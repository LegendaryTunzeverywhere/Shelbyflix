# ============================================================================
# SHELBYFLIX ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to git - it's in .gitignore for security
# ============================================================================

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================
# Network selection: SHELBYNET (production) or TESTNET (development)
# Documentation: https://docs.shelby.xyz/apis/rpc/shelbynet
NEXT_PUBLIC_NETWORK_NAME=SHELBYNET

# ============================================================================
# SHELBYNET-1 ENDPOINTS (Production - Recommended)
# ============================================================================
# Official Shelbynet-1 RPC endpoints for production use
NEXT_PUBLIC_SHELBYNET_NODE_URL=https://api.shelbynet.shelby.xyz/v1
NEXT_PUBLIC_SHELBYNET_INDEXER_URL=https://api.shelbynet.shelby.xyz/v1/graphql
NEXT_PUBLIC_SHELBYNET_API_BASE=https://api.shelbynet.shelby.xyz
NEXT_PUBLIC_SHELBYNET_FAUCET_URL=https://faucet.shelbynet.shelby.xyz

# ============================================================================
# ALTERNATIVE: TESTNET ENDPOINTS (Development/Testing Only)
# ============================================================================
# Uncomment these and comment out the SHELBYNET endpoints above for testnet:
# NEXT_PUBLIC_NETWORK_NAME=TESTNET
# NEXT_PUBLIC_SHELBYNET_NODE_URL=https://api.testnet.aptoslabs.com/v1
# NEXT_PUBLIC_SHELBYNET_INDEXER_URL=https://api.testnet.aptoslabs.com/v1/graphql
# NEXT_PUBLIC_SHELBYNET_API_BASE=https://api.testnet.shelby.xyz
# NEXT_PUBLIC_SHELBYNET_FAUCET_URL=https://faucet.testnet.shelby.xyz

# Shelby Storage API Key (server-only, no NEXT_PUBLIC prefix)
# Get yours at: https://shelby.xyz/api-keys
SHELBY_API_KEY=your_shelby_api_key_here

# Shelby Platform Account (server-only, no NEXT_PUBLIC prefix)
#
# Shelby's blob storage layer requires the account that registers a blob to
# later sign a raw-bytes ownership challenge (ShelbyRPCClient.signChallenge)
# when uploading chunk data. Browser wallets (Petra, etc.) deliberately do
# not expose raw-bytes signing — wallet-standard signMessage() always wraps
# the input in a structured frame before signing, which produces a
# different signature than Shelby's RPC expects. This means the connected
# user's own wallet can never satisfy Shelby's storage-layer ownership
# check, regardless of which account "should" own the content.
#
# This platform account is the Shelby-level owner of record for ALL blobs
# uploaded through this app — Shelbyflix, not individual creators, pays the
# Shelby registration/storage fees. This is a storage-layer bookkeeping
# detail only: actual content control (who can view/decrypt, pricing,
# access policy changes, purchase proceeds) is entirely separate and still
# governed by each creator's own wallet via the access_control Move module
# (register_blob_v2 / update_access_policy / purchase are unaffected).
#
# Generate a dedicated account for this (do NOT reuse a personal wallet):
#   aptos key generate --output-file platform-key
# Fund it with ShelbyUSD + APT for gas before uploads will work.
SHELBY_PLATFORM_PRIVATE_KEY=your_platform_account_ed25519_private_key_hex_here

# Platform moderation (server-only, no NEXT_PUBLIC prefix)
#
# Comma-separated list of 0x-prefixed wallet addresses authorized to remove
# any video on the platform (e.g. harmful/policy-violating content), not
# just their own uploads. Checked in app/api/videos/[id]/route.ts's DELETE
# handler alongside the normal "you're the original uploader" check.
#
# Note: this only removes the video's Supabase record and its Shelby
# storage bytes (both of which the platform account genuinely controls).
# It cannot modify the on-chain access_control policy entry for content
# uploaded by someone else -- that module (faithfully matching Shelby's
# real contract) derives a blob's identity from the signer's own address,
# with no admin-override function, so only the original creator's wallet
# can ever call delete_blob/update_access_policy on their own entry. This
# is harmless for moderation purposes: once the actual content bytes and
# app-visible record are gone, a stale access_control entry has nothing
# left to grant access to.
ADMIN_WALLET_ADDRESSES=0xyour_admin_wallet_address_here,0xanother_admin_if_any

# Upload staging — no separate env var needed
#
# Vercel serverless functions have a hard 4.5MB request body limit that
# cannot be raised via config — encrypted video uploads routinely exceed
# it. The browser stages the encrypted blob to a private Supabase Storage
# bucket first (bypassing the function body limit entirely), and
# app/api/uploads/route.ts downloads it server-side from there.
#
# This previously used Vercel Blob instead, but that hit a confirmed,
# currently unresolved CORS bug on Vercel's own infrastructure — the
# actual upload PUT fails with no Access-Control-Allow-Origin header,
# reported independently by other developers with identical environments
# (community.vercel.com/t/46967). Switched to Supabase Storage, which
# reuses the SUPABASE_SERVICE_ROLE_KEY documented further below — no
# additional setup needed, and the staging bucket is created
# automatically on first use.

# ============================================================================
# SMART CONTRACTS (Testnet Addresses)
# ============================================================================
# Access Control Module - Manages video access policies
# Deployed our contract at https://explorer.aptoslabs.com/txn/0x37efacdd43072d8190dcd5042d4c172d1811a1ce8e83f370d90d8ac9adb7f35d?network=testnet
NEXT_PUBLIC_ACCESS_CONTROL_MODULE_ADDRESS=
# Accepted values: supabase | move  (selects which AccessBackend resolveAccess uses)
NEXT_PUBLIC_ACCESS_BACKEND=move

#0x5211945b33c28c975544f65d361c3739a0244eb6779920128d72e7f70c088069

# Blob Storage Contract - Handles video file storage
NEXT_PUBLIC_BLOB_CONTRACT_ADDRESS=0x85fdb9a176ab8ef1d9d9c1b60d60b3924f0800ac1de1cc2085fb0b8bb4988e6a
NEXT_PUBLIC_BLOB_CONTRACT_ADDRESS_FALLBACK=0xc63d6a5efb0080a6029403131715bd4971e1149f7cc099aac69bb0069b3ddbf5

# ShelbyUSD Token - Payment token for video purchases

# If you only have the contract address, set the full token type tag
# in your .env.local to avoid wallet typeTag parse errors.
NEXT_PUBLIC_SHELBYUSD_TOKEN_ADDRESS=0x1b18363a9f1fe5e6ebf247daba5cc1c18052bb232efdc4c50f556053922d98e1

# ============================================================================
# ACCESS CONTROL BACKEND
# ============================================================================
# Choose which backend to use for access control checks:
# - "move" = Read directly from blockchain (authoritative, slower)
# - "supabase" = Read from database cache (faster, requires trust)
NEXT_PUBLIC_ACCESS_BACKEND=move

# ============================================================================
# VIDEO SETTINGS
# ============================================================================
# Fee to watch a video (in ShelbyUSD base units, 8 decimals)
# Default: 10000000 = 0.1 ShelbyUSD
NEXT_PUBLIC_WATCH_FEE=10000000

# Maximum video file size (bytes)
# Default: 10737418240 = 10GB
NEXT_PUBLIC_MAX_VIDEO_SIZE=10737418240

# Short video threshold (seconds)
# Videos shorter than this are automatically categorized as "shorts"
NEXT_PUBLIC_SHORT_VIDEO_THRESHOLD=60

# Default availability period (days)
# How long videos are available before expiring
NEXT_PUBLIC_DEFAULT_AVAILABILITY_DAYS=60

# ============================================================================
# SUPABASE DATABASE
# ============================================================================
# Supabase project URL
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous key (public, safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (server-only, NEVER expose to browser!)
# This key bypasses Row Level Security - keep it secret!
# DO NOT add NEXT_PUBLIC_ prefix to this variable
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Legacy/alternative naming (some code may reference these)
SUPABASE_URL=https://your-project-id.supabase.co

# ============================================================================
# AUTHENTICATION (Optional)
# ============================================================================
# Google OAuth Client ID (for Google sign-in)
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ============================================================================
# CRON JOBS (Optional)
# ============================================================================
# Secret for authenticating cron job requests
# Generate a random string: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# ============================================================================
# DEPLOYMENT (Optional)
# ============================================================================
# Public URL of your deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================
# 1. Get testnet tokens: https://faucet.testnet.aptoslabs.com
# 2. Get ShelbyUSD tokens: https://faucet.shelbynet.shelby.xyz
# 3. Install Petra wallet: https://petra.app
# 4. Set up Supabase: See SUPABASE_RLS_FIX.sql for database setup
# 5. Never commit .env.local - it contains secrets!
# ============================================================================
