# ============================================================================
# SHELBYFLIX ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to git - it's in .gitignore for security
# ============================================================================

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================
# Aptos network to use (TESTNET for development)
NEXT_PUBLIC_NETWORK_NAME=TESTNET

# Aptos testnet endpoints
NEXT_PUBLIC_SHELBYNET_NODE_URL=https://api.testnet.aptoslabs.com/v1
NEXT_PUBLIC_SHELBYNET_INDEXER_URL=https://api.testnet.aptoslabs.com/v1/graphql
NEXT_PUBLIC_SHELBYNET_FAUCET_URL=https://faucet.testnet.shelby.xyz

# Shelby Storage API Key (server-only, no NEXT_PUBLIC prefix)
# Get yours at: https://shelby.xyz/api-keys
SHELBY_API_KEY=your_shelby_api_key_here

# ============================================================================
# SMART CONTRACTS (Testnet Addresses)
# ============================================================================
# Access Control Module - Manages video access policies
# Deployed our contract at https://explorer.aptoslabs.com/txn/0x37efacdd43072d8190dcd5042d4c172d1811a1ce8e83f370d90d8ac9adb7f35d?network=testnet
NEXT_PUBLIC_ACCESS_CONTROL_MODULE_ADDRESS=0x8e09cdeebdebcf4885c8d6b8a388a7a01e1b8c9327c886ea234b5d92bfa8d652

#0x5211945b33c28c975544f65d361c3739a0244eb6779920128d72e7f70c088069

# Blob Storage Contract - Handles video file storage
NEXT_PUBLIC_BLOB_CONTRACT_ADDRESS=0x85fdb9a176ab8ef1d9d9c1b60d60b3924f0800ac1de1cc2085fb0b8bb4988e6a
NEXT_PUBLIC_BLOB_CONTRACT_ADDRESS_FALLBACK=0xc63d6a5efb0080a6029403131715bd4971e1149f7cc099aac69bb0069b3ddbf5

# ShelbyUSD Token - Payment token for video purchases

# If you only have the contract address, set the full token type tag
# in your .env.local to avoid wallet typeTag parse errors.
NEXT_PUBLIC_SHELBYUSD_TOKEN_ADDRESS=0x1b18363a9f1fe5e6ebf247daba5cc1c18052bb232efdc4c50f556053922d98e1

# ============================================================================
# ACCESS CONTROL BACKEND
# ============================================================================
# Choose which backend to use for access control checks:
# - "move" = Read directly from blockchain (authoritative, slower)
# - "supabase" = Read from database cache (faster, requires trust)
NEXT_PUBLIC_ACCESS_BACKEND=move

# ============================================================================
# VIDEO SETTINGS
# ============================================================================
# Fee to watch a video (in ShelbyUSD base units, 8 decimals)
# Default: 10000000 = 0.1 ShelbyUSD
NEXT_PUBLIC_WATCH_FEE=10000000

# Maximum video file size (bytes)
# Default: 10737418240 = 10GB
NEXT_PUBLIC_MAX_VIDEO_SIZE=10737418240

# Short video threshold (seconds)
# Videos shorter than this are automatically categorized as "shorts"
NEXT_PUBLIC_SHORT_VIDEO_THRESHOLD=60

# Default availability period (days)
# How long videos are available before expiring
NEXT_PUBLIC_DEFAULT_AVAILABILITY_DAYS=60

# ============================================================================
# SUPABASE DATABASE
# ============================================================================
# Supabase project URL
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous key (public, safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (server-only, NEVER expose to browser!)
# This key bypasses Row Level Security - keep it secret!
# DO NOT add NEXT_PUBLIC_ prefix to this variable
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Legacy/alternative naming (some code may reference these)
SUPABASE_URL=https://your-project-id.supabase.co

# ============================================================================
# AUTHENTICATION (Optional)
# ============================================================================
# Google OAuth Client ID (for Google sign-in)
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ============================================================================
# CRON JOBS (Optional)
# ============================================================================
# Secret for authenticating cron job requests
# Generate a random string: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# ============================================================================
# DEPLOYMENT (Optional)
# ============================================================================
# Public URL of your deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================
# 1. Get testnet tokens: https://faucet.testnet.aptoslabs.com
# 2. Get ShelbyUSD tokens: https://faucet.shelbynet.shelby.xyz
# 3. Install Petra wallet: https://petra.app
# 4. Set up Supabase: See SUPABASE_RLS_FIX.sql for database setup
# 5. Never commit .env.local - it contains secrets!
# ============================================================================
